# ─────────────────────────────────────────
# COPY FILE INI JADI .env, LALU ISI SEMUA NILAI DI BAWAH
#   cp .env.example .env
#   nano .env
# JANGAN commit file .env ke GitHub.
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# POSTGRES
# ─────────────────────────────────────────
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=GantiPasswordKuat123
# ⚠️ Hindari karakter @ # $ di password (pelajaran dari deploy Dashboard v2)
POSTGRES_DB=openwebui

# ─────────────────────────────────────────
# APLIKASI
# ─────────────────────────────────────────
# URL yang dipakai department head untuk akses (LAN/VPN only)
#   prod: http://cochat.ckd-otto.com:3010      (172.21.2.29)
#   dev : http://cochat-dev.ckd-otto.com:3010  (172.21.2.157)
# ⚠️ Nilai ini juga tersimpan di DB (tabel config, key "webui.url") setelah start
#    pertama — kalau domain berubah, update juga di DB, bukan hanya di .env.
WEBUI_URL=http://cochat.ckd-otto.com:3010
# Generate dengan: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGEME_random_string_min_32_karakter

# ─────────────────────────────────────────
# KEYCLOAK SSO — realm "ckdo" yang SUDAH ADA, client BARU khusus app ini
# ─────────────────────────────────────────
#   prod: Keycloak di dashboard.ckd-otto.com
#   dev : Keycloak di dashboard-dev.ckd-otto.com
KEYCLOAK_OIDC_DISCOVERY_URL=http://dashboard.ckd-otto.com/auth/realms/ckdo/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=ckdo-openwebui
KEYCLOAK_CLIENT_SECRET=CHANGEME_dari_tab_Credentials_di_Keycloak

# ─────────────────────────────────────────
# OPENROUTER
# ─────────────────────────────────────────
# Ambil di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────
# AI SERVER (VM101 ai-engine) — dipakai untuk embedding RAG, opsional
# ─────────────────────────────────────────
OLLAMA_SERVER_URL=http://172.21.2.27:11434
